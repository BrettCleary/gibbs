# AlloyLab API — container image for Vercel (services/container runtime).
# Build context is the repo root so the uv workspace (apps/api + packages/science) resolves.

# ---- builder: needs a C++ toolchain because icet compiles from source ----
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app

# Dependencies first (cached unless the lock/manifests change).
COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/
COPY packages/science/pyproject.toml packages/science/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace

# Then the source, and install the workspace packages themselves.
COPY apps/api apps/api
COPY packages/science packages/science
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ---- runtime: slim image, no compiler ----
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/apps/api /app/apps/api
COPY --from=builder /app/packages/science /app/packages/science
COPY infra/pseudopotentials infra/pseudopotentials
EXPOSE 80
# Absolute venv path, not `uvicorn`: Vercel's container runtime injects its own
# environment at start-up and clobbers the PATH set above (exit 127 otherwise).
# PORT defaults to 80 — the port Vercel routes to unless PORT is set in project settings.
CMD ["sh", "-c", "exec /app/.venv/bin/uvicorn alloylab.main:app --host 0.0.0.0 --port ${PORT:-80}"]
