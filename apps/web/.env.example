# Copy to apps/web/.env.local — read by Next.js and by the db:* drizzle-kit scripts.

# Supabase Postgres connection (session mode) for drizzle-kit migrations / Drizzle client.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
# Hosted project: Project Settings → Database → Session pooler URI, e.g.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# supabase-js (browser). Local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase status`>

# The FastAPI backend the UI talks to.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better Auth (email + password). Generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=<random 32+ byte secret>
# Public origin of this Next.js app (used for auth cookies/redirects).
BETTER_AUTH_URL=http://localhost:3000
