# Copy to apps/api/.env — read by the API and the Temporal worker (pydantic-settings).
# Also read when running `uv run` from the repo root.

# Database (Supabase Postgres; schema managed by Drizzle in apps/web).
ALLOYLAB_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54332/postgres
# Zero-config alternative (no Supabase needed):
# ALLOYLAB_DATABASE_URL=sqlite+aiosqlite:///./alloylab.db

# LLM scientist (Pydantic AI). Provider-prefixed model + that provider's key.
ALLOYLAB_AGENT_MODEL=openai:gpt-5
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...            # with ALLOYLAB_AGENT_MODEL=anthropic:claude-sonnet-4-5
# ALLOYLAB_AGENT_MODEL=test        # keyless built-in test model

# Real DFT (Quantum ESPRESSO) — optional.
# ALLOYLAB_PW_COMMAND=/Users/you/.local/qe/bin/pw.x
# ALLOYLAB_PSEUDO_DIR=/absolute/path/to/repo/infra/pseudopotentials
ALLOYLAB_ARTIFACTS_DIR=./alloylab_data
ALLOYLAB_OMP_NUM_THREADS=4

# Durable execution — optional. local | temporal
ALLOYLAB_EXECUTOR=local
ALLOYLAB_TEMPORAL_ADDRESS=localhost:7233
ALLOYLAB_MAX_CONCURRENT_JOBS=2
